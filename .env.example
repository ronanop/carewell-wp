# Care Well Medical Centre — Hostinger production env template
# Copy to Hostinger Node env (or local `.env`) — never commit real secrets.

# Canonical public URL (trailing slash optional; code normalizes)
NEXT_PUBLIC_SITE_URL=https://www.carewellmedicalcentre.com

# Auth.js (admin leads console)
AUTH_URL=https://www.carewellmedicalcentre.com
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Neon Postgres (pooler connection string)
DATABASE_URL=

# Sanity CMS
SANITY_PROJECT_ID=ndeeiwkw
SANITY_DATASET=production
# Viewer token for draft/preview reads (prefer over write token)
SANITY_API_TOKEN=
# Editor token — mutations / imports only (keep out of preview path)
SANITY_WRITE_TOKEN=

# Lead email notify (clinic inbox) — SMTP preferred on Hostinger
LEAD_NOTIFY_TO=
LEAD_NOTIFY_FROM=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Optional: Resend instead of / in addition to SMTP
# RESEND_API_KEY=
# Optional webhook (Zapier/Make)
# LEAD_NOTIFY_WEBHOOK_URL=

# Google Analytics 4 (Measurement ID) — leave empty to disable
NEXT_PUBLIC_GA_ID=

# First /admin/login user (created only if that email does not exist yet)
STUDIO_BOOTSTRAP_EMAIL=admin@carewellmedicalcentre.com
STUDIO_BOOTSTRAP_PASSWORD=
# Set true once on a deploy to reset that password, then remove
# STUDIO_BOOTSTRAP_FORCE=
